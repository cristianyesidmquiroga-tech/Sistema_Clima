# PostgreSQL
DB_USER=clima
DB_PASS=clima123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clima_db

# Seguridad de la app
# Passkey esperado en los datos que envia la estacion (POST /data/report/).
# Debe coincidir con el PASSKEY configurado en la estacion Sainlogic.
# Si se deja vacio, no se valida (no recomendado en produccion).
STATION_PASSKEY=

# Origenes permitidos para CORS, separados por coma (ej: https://clima.proyecto.sbs).
# Si se deja vacio, CORS queda deshabilitado (recomendado si el dashboard
# es servido desde el mismo dominio de la API).
ALLOWED_ORIGINS=

# Habilita el endpoint publico /api/test que inserta datos de prueba.
# Dejar en false en produccion.
ENABLE_TEST_ENDPOINT=false

# API Key de Wunderground (Member Settings > API Keys). La usa la app
# para el mapa de lluvias (/api/mapa_lluvias) y el historial por estacion,
# y el poller para traer los datos de la estacion propia.
WU_API_KEY=

# Limites de peticiones por hora segun el pais de la IP (deteccion via
# ip-api.com). Las IPs locales/internas de Docker siempre cuentan como
# Colombia. Al superar el limite se responde 403 y se manda un correo
# de alerta (ver SMTP_* abajo).
LIMITE_HORA_COLOMBIA=1000 per hour
LIMITE_HORA_EXTRANJERO=50 per hour

# SMTP para el reporte semanal y las alertas de seguridad (IPs bloqueadas
# por exceso de peticiones). Con Gmail hay que usar una "contraseña de
# aplicacion", no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
EMAIL_FROM=

# Clave para publicar noticias desde /admin/noticias. Si se deja vacio,
# nadie puede publicar (el formulario siempre responde "clave incorrecta").
ADMIN_PASSKEY=

# Pone todo el sitio en pantalla de mantenimiento (excepto /static/).
# Se activa/desactiva sin tocar codigo, solo cambiando esta variable y
# reiniciando el contenedor.
MODO_MANTENIMIENTO=false

# Cada cuanto (en segundos) el servicio historial_poller trae el
# historial del dia de las estaciones publicas de Wunderground.
HISTORIAL_POLL_INTERVAL=1800
