# PostgreSQL
DB_USER=clima
DB_PASS=clima123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clima_db

# Seguridad de la app
# Passkey esperado en los datos que envia la estacion (POST /data/report/).
# Debe coincidir con el PASSKEY configurado en la estacion Sainlogic.
# Si se deja vacio, no se valida (no recomendado en produccion).
STATION_PASSKEY=

# Origenes permitidos para CORS, separados por coma (ej: https://clima.proyecto.sbs).
# Si se deja vacio, CORS queda deshabilitado (recomendado si el dashboard
# es servido desde el mismo dominio de la API).
ALLOWED_ORIGINS=

# Habilita el endpoint publico /api/test que inserta datos de prueba.
# Dejar en false en produccion.
ENABLE_TEST_ENDPOINT=false
