# PostgreSQL — obligatorias, sin valor por defecto. Usa credenciales
# propias y una contraseña fuerte (no "clima123" ni similares).
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clima_db

# Seguridad de la app
# Passkey esperado en los datos que envia la estacion (POST /data/report/).
# Debe coincidir con el PASSKEY configurado en la estacion Sainlogic.
# Obligatorio: si se deja vacio, el endpoint rechaza TODOS los datos
# (fail-closed), la estacion no podra reportar hasta que se configure.
STATION_PASSKEY=

# Origenes permitidos para CORS, separados por coma (ej: https://www.nuestroclima.co).
# Si se deja vacio, CORS queda deshabilitado (recomendado si el dashboard
# es servido desde el mismo dominio de la API).
ALLOWED_ORIGINS=

# API Key de Wunderground (Member Settings > API Keys). La usa la app
# para el mapa de lluvias (/api/mapa_lluvias) y el historial por estacion,
# y el poller para traer los datos de la estacion propia.
WU_API_KEY=

# Limites de peticiones por hora segun el pais de la IP (deteccion via
# ip-api.com). Las IPs locales/internas de Docker siempre cuentan como
# Colombia. Al superar el limite se responde 403 y se manda un correo
# de alerta (ver SMTP_* abajo).
LIMITE_HORA_COLOMBIA=1000 per hour
LIMITE_HORA_EXTRANJERO=50 per hour

# SMTP para el reporte semanal y las alertas de seguridad (IPs bloqueadas
# por exceso de peticiones). Con Gmail hay que usar una "contraseña de
# aplicacion", no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
EMAIL_FROM=

# Clave para publicar noticias desde /admin/noticias. Si se deja vacio,
# nadie puede publicar (el formulario siempre responde "clave incorrecta").
ADMIN_PASSKEY=

# Pone todo el sitio en pantalla de mantenimiento (excepto /static/).
# Se activa/desactiva sin tocar codigo, solo cambiando esta variable y
# reiniciando el contenedor.
MODO_MANTENIMIENTO=false

# Cada cuanto (en segundos) el servicio historial_poller trae el
# historial del dia de las estaciones publicas de Wunderground.
HISTORIAL_POLL_INTERVAL=1800

# Cada cuanto (en segundos) se guarda la lectura diaria de las 16
# estaciones FEWS/IDEAM de Velez (por defecto 1 dia). El reporte semanal
# calcula minimo/maximo por municipio a partir de estas lecturas.
LECTURAS_FEWS_INTERVALO=86400

# Cada cuanto (en segundos) se publica un nuevo Reporte Provincia de
# Velez (por defecto 1 semana). El publico siempre ve el ultimo
# publicado, nunca un calculo en vivo.
REPORTE_VELEZ_INTERVALO=604800

# Cada cuanto (en segundos) se guarda una captura satelital nueva para
# el archivo historico (por defecto 1 dia). Ver docs/archivo_capturas_mapas.md
# para la politica de compresion a los 3 meses.
CAPTURAS_MAPAS_INTERVALO=86400

# Token de Cloudflare Web Analytics (analitica sin cookies ni perfilado).
# Se obtiene en el panel de Cloudflare: Analytics -> Web Analytics -> agregar
# el sitio. Si queda vacio, no se carga nada de analitica.
CLOUDFLARE_ANALYTICS_TOKEN=

# Reenvio de cada lectura de la estacion al piloto (backend Go). Si alguna de
# las dos queda vacia, no se reenvia nada. La clave es la STATION_PASSKEY del piloto.
# Ej: https://api.nuestroclima.co/data/report/
PILOTO_INGESTA_URL=
PILOTO_PASSKEY=

# Sello por hora de las lecturas en la red SNA (contrato RegistroHuellas).
# Si falta alguna, el servicio sellador queda quieto y no sella nada.
# La clave del RPC, la llave de la billetera selladora y la sal van solo en Coolify.
SNA_RPC_URL=https://rpc-sna.proyecto.sbs
SNA_RPC_USUARIO=sna
SNA_RPC_CLAVE=
SNA_REGISTRO=0x8c87D61e768C9D37E1f186558c16C0e70B8Aa946
SNA_LLAVE_SELLADORA=
# Texto aleatorio de 32+ caracteres; sin ella nadie adivina las lecturas a partir de la huella.
SELLO_SAL=
